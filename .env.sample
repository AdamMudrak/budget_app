# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/moneta_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=moneta_user
SPRING_DATASOURCE_PASSWORD=moneta_pass
MYSQL_DATABASE=moneta_db
MYSQL_ROOT_PASSWORD=root
SPRING_LIQUIBASE_CHANGE_LOG=/db/changelog/db.changelog-master.yaml

# Security
JWT_ACTION_EXPIRATION=600000
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET=local-development-jwt-secret-at-least-32-bytes

# Telegram
# Disabled by default so the app can start locally without a real bot token.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_TOKEN=local-telegram-token

# HTTP paths
SERVER_PATH=http://localhost:8081
ORIGINS_ALLOWED=http://localhost:3000,http://localhost:8081
REGISTRATION_CONFIRMATION_LINK=http://localhost:8081/auth/register-success
PASSWORD_RESET_CONFIRMATION_LINK=http://localhost:8081/auth/reset-password
ACTION_ERROR_LINK=http://localhost:8081
GET_RANDOM_PASSWORD_REDIRECT_LINK=http://localhost:8081

# Email service
# Dummy values let the app start. Email-sending endpoints require real Resend settings.
SENDER_EMAIL_ADDRESS=no-reply@example.com
RESEND_API_KEY=local-resend-api-key
SUPPORT_MAIL_ADDRESS=support@example.com
